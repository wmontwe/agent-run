#!/usr/bin/env bash
# Hardened launcher: runs an agent on a Git workspace with .git and .idea
# mounted read-only and .signing hidden, keeps shared memory to plain notes, and
# reports changes the host may execute. Mounts the project's engram context
# when its AGENTS.md links into one (AGENT_ENGRAM=0 skips that). Supports
# macOS bash 3.2.
#
# This file is the orchestrator: it holds the configuration and the order of
# the checks. The checks themselves live in lib/ and are tested in tests/.
set -euo pipefail

usage() {
    echo "usage: agent claude|codex|gemini|pi [command...]" >&2
    echo "       agent trust-memory    record ~/.agent-run/memory/.git as yours" >&2
    echo "       agent trust-tools     approve this workspace's mise config for install" >&2
    echo "       agent refresh-tools claude|codex|gemini|pi" >&2
    echo "                             remove the agent's installed tools and Gradle" >&2
    echo "                             distributions; the next launch installs them again" >&2
    exit 2
}

[[ $# -ge 1 ]] || usage
command=run
case "$1" in
    claude|codex|gemini|pi) name="$1"; shift ;;
    trust-memory|trust-tools) [[ $# -eq 1 ]] || usage; command="$1"; name="" ;;
    refresh-tools)
        [[ $# -eq 2 ]] || usage
        case "$2" in claude|codex|gemini|pi) ;; *) usage ;; esac
        command="$1"; name="$2" ;;
    *) usage ;;
esac

# The launcher root holds this script, lib/, compose.yaml and proxy/. Resolve
# it through any symlink (e.g. ~/bin/agent), since the target is what runs.
# Libraries are sourced only from there; the overlap check below keeps it out
# of every agent's reach.
entry="${BASH_SOURCE[0]}"
while [[ -L "$entry" ]]; do
    entry_dir="$(cd -P -- "$(dirname -- "$entry")" && pwd -P)"
    entry="$(readlink -- "$entry")"
    [[ "$entry" == /* ]] || entry="$entry_dir/$entry"
done
root="$(cd -P -- "$(dirname -- "$entry")/.." && pwd -P)"
for lib in common protect git-guard memory report lock engram tools github gradle podman; do
    [[ -f "$root/lib/$lib.sh" ]] || { echo "agent: $root/lib/$lib.sh not found" >&2; exit 1; }
    # shellcheck source=/dev/null
    . "$root/lib/$lib.sh"
done
[[ -f "$root/compose.yaml" ]] || die "compose.yaml not found in $root"

# Memory's .git is only trusted with this record, which no container can reach.
memory_marker="$HOME/.agent-run/memory.git-id"
# Approved mise configs (agent trust-tools), one record per workspace, where no
# container can reach them.
tools_trust_dir="$HOME/.agent-run/tools-trust"
case "$command" in
    trust-memory)
        mem="$(canonical "$HOME/.agent-run/memory")" || die "missing $HOME/.agent-run/memory"
        trust_memory_repo "$mem" "$memory_marker"
        echo "Recorded $mem/.git as your memory repository."
        exit 0 ;;
    trust-tools)
        ws="$(canonical "${WORKSPACE:-$PWD}")" || die "workspace is not a directory: ${WORKSPACE:-$PWD}"
        require_git_dir "$ws"
        tmp="$(mktemp -d "${TMPDIR:-/tmp}/agent-run.XXXXXX")"
        trap 'rm -rf -- "$tmp"' EXIT
        # The copies are what gets approved, as at launch.
        copy_tool_config "$ws" "$tmp"
        case "$TOOL_CONFIG" in
            none) die "$ws has no mise.toml or .mise.toml" ;;
            unlocked) die "$ws has no mise.lock; run there first: mise lock --platform linux-arm64,macos-arm64" ;;
        esac
        trust_tool_config "$tmp" "$tools_trust_dir/$(workspace_id "$ws")" "$ws"
        approved=""
        for file in mise.toml .mise.toml mise.lock; do
            if [[ -f "$tmp/$file" ]]; then approved="$approved $file"; fi
        done
        echo "Approved$approved in $ws for install."
        exit 0 ;;
    refresh-tools)
        require_rootless
        tools_lock="$HOME/.agent-run/tools-$name.lock"
        memory_lock "$tools_lock" 1800
        trap 'memory_unlock "$tools_lock"' EXIT
        remove_tool_volumes "$name"
        echo "Removed $name's tools and Gradle distributions; the next launch installs them again."
        exit 0 ;;
esac

# Signing material is hidden: an existing directory is covered by an empty
# read-only one. IDE configuration stays readable but is mounted read-only,
# since run configurations can execute code. A missing directory is not created
# (that would leave a mount point in the repository); if the agent creates it,
# the report says so.
hidden=(.signing)
readonly_dirs=(.idea)
# Files hidden the same way, behind an empty read-only file: local.properties
# holds host paths (sdk.dir) and often secrets.
hidden_files=(local.properties)

# Canonicalize the workspace once; this exact path is used for every mount,
# and the container sees the workspace at the same path, so paths in build
# state and links (engram's) mean the same on the host and in the container.
ws="${WORKSPACE:-$PWD}"
ws="$(canonical "$ws")" || die "workspace is not a directory: ${WORKSPACE:-$PWD}"
check_path_chars workspace "$ws"
check_container_path workspace "$ws"
require_git_dir "$ws"
for dir in "${hidden[@]}" "${readonly_dirs[@]}"; do
    check_protectable_dir "$ws/$dir"
done
for file in "${hidden_files[@]}"; do
    check_protectable_file "$ws/$file"
done
for dir in "${readonly_dirs[@]}"; do
    [[ -d "$ws/$dir" ]] && check_no_symlinks "$ws/$dir"
done

require_rootless

# Every other mount source, canonicalized so symlinks into the workspace are
# caught. None may overlap the workspace.
sources=("$root")
for dir in "$HOME/.agent-run/knowledge" "$HOME/.agent-run/memory" \
           "$HOME/.agent-run/$name/home"; do
    src="$(canonical "$dir")" ||
        die "missing $dir; create it with: mkdir -p ~/.agent-run/{knowledge,memory} ~/.agent-run/$name/home"
    sources+=("$src")
done
github_repos="$HOME/.agent-run/github-repos.txt"
[[ ! -e "$github_repos" && ! -L "$github_repos" ]] || check_github_repos "$github_repos"
for src in "${sources[@]}"; do
    overlaps "$ws" "$src" && die "workspace $ws overlaps $src, which must stay out of the agent's reach"
done

mem="$(canonical "$HOME/.agent-run/memory")"
check_path_chars memory "$mem"
detect_memory_repo "$mem" "$memory_marker"

# The project's engram context, if its AGENTS.md links into one. The whole
# context repository must stay apart from the workspace and the other mounts.
ENGRAM=false
if [[ "${AGENT_ENGRAM:-1}" != 0 ]]; then
    detect_engram "$ws"
fi
if [[ $ENGRAM == true ]]; then
    for src in "$ws" "${sources[@]}"; do
        overlaps "$ENGRAM_ROOT" "$src" && die "engram repository $ENGRAM_ROOT overlaps $src"
    done
fi
# Agent-writable folders besides the workspace, memory and the agent's home.
extra_writable=()
[[ -n "${ENGRAM_MEMORY:-}" ]] && extra_writable+=("$ENGRAM_MEMORY")

# Memory maintenance (quarantine with the other agents paused) and container
# starts take this lock, so no agent can write to memory, or newly start,
# while memory is being quarantined.
lock_dir="$HOME/.agent-run/memory.lock"
PAUSED=()
tmp="$(mktemp -d "${TMPDIR:-/tmp}/agent-run.XXXXXX")"
cleanup() {
    resume_paused
    memory_unlock "$lock_dir"
    [[ -z "${tools_lock:-}" ]] || memory_unlock "$tools_lock"
    rm -rf -- "$tmp"
}
trap cleanup EXIT
tmp="$(canonical "$tmp")"
mkdir -- "$tmp/empty"
: >"$tmp/empty-file"

git_guard_init "$ws" "$mem" "$MEM_REPO" "$tmp" ${extra_writable[@]+"${extra_writable[@]}"}
check_git_config 0 "$ws"
[[ $MEM_REPO == true ]] && check_git_config 0 "$mem"
# engram save runs Git in the context repository on the host.
[[ $ENGRAM == true ]] && check_git_config 0 "$ENGRAM_ROOT"

protect_mounts=()
for dir in "${hidden[@]}"; do
    [[ -d "$ws/$dir" ]] && protect_mounts+=(-v "$tmp/empty:$ws/$dir:ro,z")
done
for file in "${hidden_files[@]}"; do
    [[ -f "$ws/$file" ]] && protect_mounts+=(-v "$tmp/empty-file:$ws/$file:ro,z")
done
for dir in "${readonly_dirs[@]}"; do
    [[ -d "$ws/$dir" ]] && protect_mounts+=(-v "$ws/$dir:$ws/$dir:ro,z")
done
for path in ${MEM_PROTECTED[@]+"${MEM_PROTECTED[@]}"}; do
    protect_mounts+=(-v "$path:/memory/${path#"$mem"/}:ro,z")
done
# The engram package where the workspace's relative links reach it, read-only
# except its .memory, plus the engram-core skills its skill links point to.
if [[ $ENGRAM == true ]]; then
    protect_mounts+=(-v "$ENGRAM_PACKAGE:$ENGRAM_AT/projects/$ENGRAM_PROJECT:ro,z")
    [[ -n "$ENGRAM_MEMORY" ]] &&
        protect_mounts+=(-v "$ENGRAM_MEMORY:$ENGRAM_AT/projects/$ENGRAM_PROJECT/.memory:z")
    [[ -n "$ENGRAM_SKILLS" ]] &&
        protect_mounts+=(-v "$ENGRAM_SKILLS:$ENGRAM_AT/engram-core/.agents/skills:ro,z")
    # A project that commits its own AGENTS.md gets engram's in the container.
    [[ -f "$ws/AGENTS.md" && ! -L "$ws/AGENTS.md" ]] &&
        protect_mounts+=(-v "$ENGRAM_PACKAGE/AGENTS.md:$ws/AGENTS.md:ro,z")
fi
for path in "$ws" "${sources[@]}" ${ENGRAM_ROOT:+"$ENGRAM_ROOT"}; do
    overlaps "$tmp" "$path" && die "temporary directory $tmp overlaps $path"
done
# The user's global gitignore, so Git in the container ignores what it does on
# the host. A copy, so no host path is mounted.
git_env=()
excludes="$(git_excludes_file)"
if [[ -n "$excludes" ]]; then
    cp -- "$excludes" "$tmp/gitignore"
    protect_mounts+=(-v "$tmp/gitignore:/etc/agent-run/gitignore:ro,z")
    git_env=(-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=core.excludesFile
        -e GIT_CONFIG_VALUE_0=/etc/agent-run/gitignore)
fi

# The user's instructions for agents, where each CLI loads its global ones. A
# read-only copy, so agents can't change what the next run starts with.
instructions="$HOME/.agent-run/instructions.md"
if [[ -e "$instructions" || -L "$instructions" ]]; then
    check_protectable_file "$instructions"
    case "$name" in
        claude) instructions_at=.claude/CLAUDE.md ;;
        codex) instructions_at=.codex/AGENTS.md ;;
        gemini) instructions_at=.gemini/GEMINI.md ;;
        pi) instructions_at=.pi/agent/AGENTS.md ;;
    esac
    check_no_symlink_path "${sources[3]}" "$instructions_at"
    [[ ! -s "${sources[3]}/$instructions_at" ]] ||
        echo "agent: ~/.agent-run/instructions.md covers $instructions_at from the agent's home" >&2
    cp -- "$instructions" "$tmp/instructions.md"
    protect_mounts+=(-v "$tmp/instructions.md:/home/node/$instructions_at:ro,z")
fi
# Pi has no MCP, so it gets the browser as a command (image/browser) and a
# skill that tells it so, read-only in its global skills like the instructions.
if [[ "$name" == pi ]]; then
    check_no_symlink_path "${sources[3]}" .pi/agent/skills/browser/SKILL.md
    cp -- "$root/image/browser-skill.md" "$tmp/browser-skill.md"
    protect_mounts+=(-v "$tmp/browser-skill.md:/home/node/.pi/agent/skills/browser/SKILL.md:ro,z")
fi

protected=("$ws/.git")
for dir in "${hidden[@]}" "${readonly_dirs[@]}"; do
    [[ -d "$ws/$dir" ]] && protected+=("$ws/$dir")
done
for file in "${hidden_files[@]}"; do
    [[ -f "$ws/$file" ]] && protected+=("$ws/$file")
done
protected+=(${MEM_PROTECTED[@]+"${MEM_PROTECTED[@]}"})
[[ -f "$instructions" ]] && protected+=("$instructions")
if [[ $ENGRAM == true ]]; then
    protected+=("$ENGRAM_PACKAGE")
    [[ -n "$ENGRAM_SKILLS" ]] && protected+=("$ENGRAM_SKILLS")
fi
# sources: launcher root, knowledge (read-only), memory, the agent's home.
writable=("$ws" "$mem" "${sources[3]}" ${extra_writable[@]+"${extra_writable[@]}"})
# The agent's own Gradle state (lib/gradle.sh) covers these folders, so the
# host's copies, where host builds may leave links (a local clone in build/),
# are out of its reach.
find_gradle_state "$ws" "$tmp"
covered=()
for path in ${GRADLE_STATE[@]+"${GRADLE_STATE[@]}"}; do
    covered+=("$ws/$path")
done
check_hard_links "$tmp" "${#writable[@]}" "${#covered[@]}" "${writable[@]}" \
    ${covered[@]+"${covered[@]}"} "${protected[@]}"

new_container_name "$name"
cname="$CONTAINER_NAME"
# Compose runs as a waited-on child (sharing the terminal), so these traps
# fire immediately and stop the container instead of waiting for it. A signal
# during the foreground steps before it only runs once they finish, so each
# step is followed by abort_if_signalled. They are set before anything is
# paused, so a signal always leads through cleanup, which resumes it.
signal=0
trap 'signal=129; stop_container "$cname"' HUP
trap 'signal=130; stop_container "$cname"' INT
trap 'signal=143; stop_container "$cname"' TERM
abort_if_signalled() {
    [[ $signal -eq 0 ]] || { echo "agent: interrupted before the agent started" >&2; exit "$signal"; }
}

# quarantine PHASE: quarantines memory, and the project's engram memory, with
# every container that has either mounted paused, so none can swap a folder
# for a symlink while it runs.
quarantine="$HOME/.agent-run/quarantine"
quarantine() {
    local rc=0
    pause_memory_users "$mem" "$HOME/.agent-run/memory" ${extra_writable[@]+"${extra_writable[@]}"}
    quarantine_in_container "localhost/agent-run-$name" "$root" "$1" "$mem" \
        "$quarantine" "$MEM_REPO" ${MEM_PROTECTED[@]+"${MEM_PROTECTED[@]}"} || rc=$?
    if [[ $rc -eq 0 && -n "${ENGRAM_MEMORY:-}" ]]; then
        quarantine_in_container "localhost/agent-run-$name" "$root" "$1" "$ENGRAM_MEMORY" \
            "$quarantine/engram-$ENGRAM_PROJECT" false || rc=$?
    fi
    resume_paused
    return $rc
}
# Install the project's locked tools (mise), its Gradle distribution and the
# Android SDK licenses into this agent's volumes, in their own container. Before
# the memory lock, since a first install can take a while; with a per-agent
# lock, since two runs of one agent share the volumes.
cd -- "$root"
copy_tool_config "$ws" "$tmp/tools"
# mise runs commands from its config, which agents can edit, so only an
# approved one is installed (agent trust-tools).
if [[ $TOOL_CONFIG == unlocked ]]; then
    echo "agent: $ws has a mise config but no mise.lock, so its tools are not installed; on the host run: mise lock --platform linux-arm64,macos-arm64" >&2
    rm -f -- "$tmp/tools/mise.toml" "$tmp/tools/.mise.toml" "$tmp/tools/mise.lock"
elif [[ $TOOL_CONFIG == locked ]] &&
    ! tool_config_trusted "$tmp/tools" "$tools_trust_dir/$(workspace_id "$ws")"; then
    echo "agent: the mise config in $ws is new or changed since you approved it, so its tools are not installed; review mise.toml and mise.lock, then run there: agent trust-tools" >&2
    rm -f -- "$tmp/tools/mise.toml" "$tmp/tools/.mise.toml" "$tmp/tools/mise.lock"
fi
licenses=""
if [[ -d "${ANDROID_HOME:-$HOME/Library/Android/sdk}/licenses" ]]; then
    licenses="$(canonical "${ANDROID_HOME:-$HOME/Library/Android/sdk}/licenses")"
    check_path_chars "Android licenses" "$licenses"
fi
compose "$root" "$ws" up -d proxy-tools >/dev/null || die "could not start proxy-tools"
tools_lock="$HOME/.agent-run/tools-$name.lock"
memory_lock "$tools_lock" 1800
abort_if_signalled
gradle_home="$(workspace_volume "$name" gradle "$ws")"
install_tools "localhost/agent-run-$name" "$name" "$tmp/tools" "$licenses" "$gradle_home" ||
    die "could not install the project's tools (see above)"
memory_unlock "$tools_lock"
tool_mounts "$name" "$gradle_home"
abort_if_signalled

# The agent's own Gradle state, found above, in a volume per agent and
# workspace.
GRADLE_STATE_MOUNTS=""
if [[ ${#GRADLE_STATE[@]} -gt 0 ]]; then
    state_volume="$(workspace_volume "$name" build "$ws")"
    prepare_gradle_state "localhost/agent-run-$name" "$state_volume" "${GRADLE_STATE[@]}"
    gradle_state_mounts "$state_volume" "$ws" "${GRADLE_STATE[@]}"
fi
abort_if_signalled

memory_lock "$lock_dir" 600
abort_if_signalled
quarantine before || die "could not check memory (is the image built? podman compose build $name)"
abort_if_signalled

# Launch from the trusted root, so workspace files can't influence Compose.
# Start the agent's proxy and the GitHub relay on their own first, so the
# agent-only options below (--podman-run-args, the extra mounts) never reach
# them; the agent then runs with --no-deps.
cd -- "$root"
compose "$root" "$ws" up -d "proxy-$name" >/dev/null || die "could not start proxy-$name"
if [[ -e "$github_repos" ]]; then
    compose "$root" "$ws" up -d github-relay >/dev/null || die "could not start github-relay"
fi
# compose.yaml's mem_limit; set here so the launch line shows the real value.
export AGENT_MEMORY="${AGENT_MEMORY:-4g}"
echo "agent: starting $name in $ws with a memory limit of $AGENT_MEMORY (AGENT_MEMORY)" >&2
abort_if_signalled
complete=true
report_snapshot "$ws" "$tmp" ${covered[@]+"${covered[@]}"} || complete=false
abort_if_signalled
compose "$root" "$ws" --podman-run-args "$AGENT_RUN_ARGS $TOOL_MOUNTS$GRADLE_STATE_MOUNTS" \
    run --rm --no-deps --name "$cname" \
    -v "$ws/.git:$ws/.git:ro,z" \
    ${protect_mounts[@]+"${protect_mounts[@]}"} \
    -e GIT_OPTIONAL_LOCKS=0 ${git_env[@]+"${git_env[@]}"} \
    "$name" "$@" <&0 &
child=$!
# Keep the lock until our container exists, so the next quarantine sees it and
# pauses it.
while kill -0 "$child" 2>/dev/null && ! podman container exists "$cname" 2>/dev/null; do
    sleep 0.25
done
memory_unlock "$lock_dir"
# wait returns early when a trap runs; keep waiting until compose exits. A
# signal can arrive before Compose has created the container, when the trap's
# stop finds nothing, so keep stopping it until Compose gives up.
while :; do
    status=0
    wait "$child" || status=$?
    kill -0 "$child" 2>/dev/null || break
    while [[ $signal -ne 0 ]] && kill -0 "$child" 2>/dev/null; do
        stop_container "$cname"
        sleep 0.5
    done
done
[[ $signal -ne 0 ]] && status=$signal

# Make sure the container is gone before scanning what it wrote.
podman container exists "$cname" 2>/dev/null && stop_container "$cname"
if podman container exists "$cname" 2>/dev/null; then
    printf 'agent: container %s is still present; skipping the change report\n' "$cname" >&2
    exit "$status"
fi

memory_lock "$lock_dir" 600
quarantine after || echo "agent: memory check after the run failed; review $mem by hand" >&2
memory_unlock "$lock_dir"
report_print "$ws" "$tmp" "$complete" "$MEM_REPO" "$mem"
[[ -n "${ENGRAM_MEMORY:-}" ]] && report_engram "$ENGRAM_ROOT" "$ENGRAM_PROJECT"

exit "$status"
