#!/bin/sh
# agent-run's command. Runs the launcher built from this repository (crates/agent),
# rebuilding it first when its sources changed, so it's never stale (a no-op build
# takes well under a second). Cargo runs in this repository, not in the caller's folder:
# Cargo reads `.cargo/config.toml` from the folder it runs in, and a checkout's is
# agent-writable (it could run code on the host). The launcher keeps the caller's folder.
# Where this script really is, also when called through a (chain of) symlink(s).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
(cd "$root" && cargo build --release --locked --quiet -p agent) || exit
exec "$root/target/release/agent" "$@"
