# One image per agent: the agent's CLI, the tools it works with,
# gradle-run, scrot and xwininfo for the session's display, and the gate as entrypoint. No
# Java, Gradle, display or browser: those run in the build container. Build from the repository root:
#   podman build --build-arg AGENT=claude -t localhost/agent-run-claude \
#       -f image/Containerfile --ignorefile image/Containerfile.ignore .

# The gate and gradle-run, as static binaries (crates/gate, crates/buildrun).
FROM docker.io/library/rust:1.99.1-alpine@sha256:44819b27be4c97b0e4d7203bd2e02c4820f97700211b6a37fb4c246a2de59383 AS gate
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo build --release --locked -p gate -p buildrun --bin agent-run-gate --bin gradle-run \
    && cp target/release/agent-run-gate target/release/gradle-run /

# Pinned by digest (the multi-arch index), so a rebuild never picks up a changed base.
FROM docker.io/library/node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl fd-find git ripgrep \
        scrot x11-utils socat \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# Each agent's CLI and every dependency are pinned with checksums in
# agents/<agent>/package-lock.json. Install scripts never run.
ARG AGENT
COPY agents/${AGENT}/package.json agents/${AGENT}/package-lock.json /opt/agent/
RUN cd /opt/agent \
    && npm ci --ignore-scripts --no-audit --no-fund \
    # Claude Code's skipped postinstall script only moves the platform binary over the
    # bin/claude.exe placeholder; done here until it installs with --ignore-scripts.
    && if [ "$AGENT" = claude ]; then \
      case "$(uname -m)" in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac; \
      mods=/opt/agent/node_modules/@anthropic-ai; \
      mv "$mods/claude-code-linux-$arch/claude" "$mods/claude-code/bin/claude.exe" \
      && chmod 755 "$mods/claude-code/bin/claude.exe"; \
    fi \
    && npm cache clean --force

COPY --from=gate --chmod=755 /agent-run-gate /gradle-run /usr/local/bin/
ENV PATH=/opt/agent/node_modules/.bin:$PATH \
    BROWSER=echo
USER node
ENTRYPOINT ["/usr/local/bin/agent-run-gate"]
